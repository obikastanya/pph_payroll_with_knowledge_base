# Copy to .env (never committed) and fill in. Read by system/pph21kbs/config.py; no need to export. See SETUP.md.

# Anthropic: main model claude-opus-5-5 (acquisition, repair). ANTHROPIC_API_KEY is also accepted.
CLAUDE_API_KEY=

# OpenAI: second model of the research gpt-6.1-sol, assistant of the app gpt-5.4-mini.
OPENAI_API_KEY=

# GraphDB Free license code from the Graphwise email (base64, one line); system/tools/graphdb_setup.py writes it to
# graphdb/graphdb.license.
GRAPHDB_LICENSE=

# Optional (defaults shown)
# PPH21_GRAPHDB_URL=http://localhost:7200
# PPH21_GRAPHDB_REPOSITORY=pph21
# PPH21_SECOND_MODEL=gpt-6.1-sol
