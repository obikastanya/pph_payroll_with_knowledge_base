# --- Rahasia: kunci API (CLAUDE_API_KEY, OPENAI_API_KEY) ---
.env

# --- GraphDB: lisensi pribadi dan data repository (dibangun ulang dari log Delta) ---
v1/graphdb/graphdb.license
v1/graphdb/home/
graph_lisence.txt

# --- Data pribadi: JANGAN PERNAH di-commit (v1/research_plan.md §15.3) ---
payroll_calculator.xlsx
*.xlsx.bak
~$*
scratch/

# --- Repo pembanding pihak ketiga: diklon ulang dari URL di dataset/03_pembanding/kandidat_repo.csv ---
# (pajakin tidak berlisensi -> dilarang didistribusikan; repo lain punya riwayat git sendiri)
v1/dataset/03_pembanding/repos/
v2/dataset/03_pembanding/repos/

# --- Salinan dokumen kebijakan perusahaan (pihak ketiga, bertanda hak cipta): hanya manifes URL + SHA-256 yang di-commit ---
v1/dataset/10_kebijakan_perusahaan/dokumen/
v2/dataset/10_kebijakan_perusahaan/dokumen/

# Teks salinan PKB pihak ketiga (dataset/13_teks): hanya manifes yang di-commit
v1/dataset/13_teks/PKB-*/teks.txt
v1/dataset/13_teks/PKB-*/segmen.json
v2/dataset/13_teks/PKB-*/teks.txt
v2/dataset/13_teks/PKB-*/segmen.json

# --- Berkas KB tambahan yang diterapkan lewat aplikasi web (data runtime per instalasi) ---
v1/kb/tambahan/*.yaml

# --- Lingkungan Python ---
env/
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.coverage
htmlcov/

# --- Node (baseline B2) ---
node_modules/

# --- Editor / OS ---
.vscode/
.idea/
Thumbs.db
desktop.ini

# --- Pengaturan lokal Claude Code (hook pribadi) ---
.claude/settings.local.json

# --- Draf penelitian: PDF referensi (lisensi beragam) dan berkas antara LaTeX ---
v1/paper/reference/pdf/
v1/paper/**/*.aux
v1/paper/**/*.bbl
v1/paper/**/*.blg
v1/paper/**/*.log
v1/paper/**/*.out
v1/paper/**/*.fls
v1/paper/**/*.fdb_latexmk
v1/paper/**/*.synctex.gz

# --- Bahan menulis dari pihak ketiga (paper orang lain, template penerbit): tidak didistribusikan ---
v1/paper_writing/*.pdf
v1/paper_writing/*.docx
v1/paper_writing/template_ieeeaccess/

# prompts that contain licensed collective-agreement text (PKB) are not committed
v1/experiments/*/prompts_private/

# Ruang kerja aplikasi (pembaruan pengguna, jalan langsung) dan dokumen unggahan
v1/system/app/workspace/
v1/dataset/13_teks/UPLOAD-*/
v2/dataset/13_teks/UPLOAD-*/
v1/experiments/app-demo/
v1/experiments/app-*/

# Ruang kerja eksperimen v2 (salinan teks dokumen termasuk PKB pihak ketiga, panggilan model, hasil antara)
v2/work/

# kunci Word saat merender set prospektif
v2/dataset/15_set_prospektif/.word.lock

# Contoh paper v2: hasil build LaTeX dan font komersial template IEEE tidak di-commit
v2/paper_example/**/*.aux
v2/paper_example/**/*.log
v2/paper_example/**/*.fls
v2/paper_example/**/*.fdb_latexmk
v2/paper_example/**/*.blg
v2/paper_example/**/*.pfb
v2/paper_example/**/*.tfm
