  {
   "kind": "rule",
   "id": "REG.PPH.DUE.FINAL",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "period",
   "produces": "pph21_due",
   "condition": "is_final_period",
   "expression": "final_period_tax",
   "valid_from": "2009-01-01",
   "source": [
    {
     "document": "PER-16-PJ-2016",
     "provision": "Pasal 14 ayat (5)",
     "page": 13,
     "quote": "selisih antara Pajak Penghasilan yang terutang atas seluruh penghasilan kena"
    }
   ],
   "recorded_on": "2009-01-01"
  },
  {
   "kind": "rule",
   "id": "REG.YEAR.GROSS",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "year",
   "produces": "annual_gross",
   "expression": "sum_periods('gross_income')",
   "valid_from": "2009-01-01",
   "source": [
    {
     "document": "PER-16-PJ-2016",
     "provision": "Pasal 14 ayat (5)",
     "page": 13,
     "quote": "selisih antara Pajak Penghasilan yang terutang atas seluruh penghasilan kena"
    }
   ],
   "recorded_on": "2009-01-01"
  },
  {
   "kind": "rule",
   "id": "REG.YEAR.JOB_EXPENSE",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "year",
   "produces": "job_expense",
   "expression": "min(round(param('job_expense_rate') * annual_gross, 1, 'down'), param('job_expense_max_month') * months_employed, param('job_expense_max_year'))",
   "valid_from": "2009-01-01",
   "label": "tafsir K6: aggregate cap of n x 500,000",
   "source": [
    {
     "document": "PER-16-PJ-2016",
     "provision": "Pasal 10 ayat (3) huruf a",
     "page": 10,
     "quote": "biaya jabatan, sebesar 5% (lima persen) dari penghasilan bruto"
    }
   ],
   "recorded_on": "2009-01-01"
  },
  {
   "kind": "rule",
   "id": "REG.YEAR.PENSION",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "year",
   "produces": "annual_pension_contributions",
   "expression": "sum_periods('employee_pension_contributions')",
   "valid_from": "2009-01-01",
   "source": [
    {
     "document": "PER-16-PJ-2016",
     "provision": "Pasal 10 ayat (3) huruf b",
     "page": 10,
     "quote": "iuran yang terkait dengan gaji yang dibayar oleh pegawai kepada dana pensiun"
    }
   ],
   "recorded_on": "2009-01-01"
  },
  {
   "kind": "rule",
   "id": "REG.YEAR.ZAKAT",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "year",
