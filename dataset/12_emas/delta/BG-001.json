  {
   "kind": "rule",
   "id": "REG.GROSS.REGULAR",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "period",
   "produces": "regular_gross",
   "expression": "base_salary + fixed_allowance + other_regular_income + overtime_pay + employer_premiums_taxable + benefits_taxable_regular + tax_allowance",
   "valid_from": "2009-01-01",
   "source": [
    {
     "document": "PER-16-PJ-2016",
     "provision": "Lampiran I angka 15",
     "page": 4,
     "quote": "berupa gaji atau upah, segala macam tunjangan, dan imbalan dengan nama"
    },
    {
     "document": "PER-16-PJ-2016",
     "provision": "Lampiran I angka 15",
     "page": 4,
     "quote": "termasuk uang lembur"
    }
   ],
   "recorded_on": "2009-01-01"
  },
  {
   "kind": "rule",
   "id": "REG.GROSS.IRREGULAR",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "period",
   "produces": "irregular_gross",
   "expression": "thr + bonus + other_irregular_income + benefits_taxable_irregular",
   "valid_from": "2009-01-01",
   "source": [
    {
     "document": "PER-16-PJ-2016",
     "provision": "Lampiran I angka 16",
     "page": 4,
     "quote": "antara lain berupa bonus, Tunjangan Hari Raya"
    }
   ],
   "recorded_on": "2009-01-01"
  },
  {
   "kind": "rule",
   "id": "REG.GROSS",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "period",
   "produces": "gross_income",
   "expression": "regular_gross + irregular_gross",
   "valid_from": "2009-01-01",
   "source": [
    {
     "document": "PER-16-PJ-2016",
     "provision": "Pasal 10 ayat (1)",
     "page": 10,
     "quote": "adalah seluruh jumlah"
    }
   ],
   "recorded_on": "2009-01-01"
  },
  {
   "kind": "rule",
   "id": "REG.PREMIUMS.TAXABLE",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "period",
   "produces": "employer_premiums_taxable",
   "expression": "jkk_premium + jkm_premium + health_premium_employer",
   "valid_from": "2009-01-01",
   "source": [
    {
     "document": "PER-16-PJ-2016",
     "provision": "Lampiran contoh",
     "page": 21,
     "quote": "(JKK), premi Jaminan Kematian (JK), dan premi"
    }
   ],
   "recorded_on": "2009-01-01"
  },
  {
   "kind": "rule",
   "id": "REG.PENSION.EMPLOYEE",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "period",
   "produces": "employee_pension_contributions",
   "expression": "jht_employee + jp_employee",
   "valid_from": "2009-01-01",
   "source": [
    {
     "document": "PER-16-PJ-2016",
     "provision": "Pasal 10 ayat (3) huruf b",
     "page": 10,
     "quote": "iuran yang terkait dengan gaji yang dibayar oleh pegawai kepada dana pensiun"
    }
   ],
   "recorded_on": "2009-01-01"
  },
  {
   "kind": "rule",
   "id": "REG.P16.JOB_EXPENSE_MONTH",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "period",
   "produces": "job_expense_month",
   "condition": "not is_final_period",
   "expression": "min(round(param('job_expense_rate') * regular_gross, 1, 'down'), param('job_expense_max_month'))",
   "valid_from": "2009-01-01",
   "source": [
    {
     "document": "PER-16-PJ-2016",
     "provision": "Pasal 10 ayat (3) huruf a",
     "page": 10,
     "quote": "biaya jabatan, sebesar 5% (lima persen) dari penghasilan bruto"
    }
   ],
   "recorded_on": "2009-01-01"
  },
  {
   "kind": "rule",
   "id": "REG.P16.NET_MONTH",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "period",
   "produces": "net_regular_month",
   "condition": "not is_final_period",
   "expression": "regular_gross - job_expense_month - employee_pension_contributions",
   "valid_from": "2009-01-01",
   "source": [
    {
     "document": "PER-16-PJ-2016",
     "provision": "Pasal 10 ayat (3)",
     "page": 10,
     "quote": "Besarnya penghasilan neto bagi Pegawai Tetap yang dipotong PPh Pasal 21 adalah"
    }
   ],
   "recorded_on": "2009-01-01"
  },
  {
   "kind": "rule",
   "id": "REG.P16.FACTOR",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "year",
   "produces": "annualization_factor",
   "expression": "12",
   "valid_from": "2009-01-01",
   "source": [
    {
     "document": "PER-16-PJ-2016",
     "provision": "Pasal 14 ayat (2) huruf a",
     "page": 13,
     "quote": "perkiraan atas penghasilan yang bersifat teratur adalah jumlah penghasilan"
    }
   ],
   "recorded_on": "2009-01-01"
  },
  {
   "kind": "rule",
   "id": "REG.P16.FACTOR.NEW_EMPLOYEE",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "year",
   "produces": "annualization_factor",
   "condition": "first_month > 1 and employee('subjective_start_month') == None",
   "expression": "12 - first_month + 1",
   "valid_from": "2009-01-01",
   "overrides": [
    "REG.P16.FACTOR"
   ],
   "source": [
    {
     "document": "PER-16-PJ-2016",
     "provision": "Pasal 14 ayat (4)",
     "page": 13,
     "quote": "jumlah bulan tersisa dalam tahun"
    }
   ],
   "recorded_on": "2009-01-01"
  },
  {
   "kind": "rule",
   "id": "REG.P16.TAXABLE_ANNUALIZED",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "period",
   "produces": "taxable_regular_annualized",
   "condition": "not is_final_period",
   "expression": "max(0, round(net_regular_month * annualization_factor - ptkp_amount, 1000, 'down'))",
   "valid_from": "2009-01-01",
   "source": [
    {
     "document": "PER-16-PJ-2016",
     "provision": "Pasal 14 ayat (2) huruf a",
     "page": 13,
     "quote": "perkiraan atas penghasilan yang bersifat teratur adalah jumlah penghasilan"
    },
    {
     "document": "PER-16-PJ-2016",
     "provision": "Pasal 14 ayat (8)",
     "page": 14,
     "quote": "dibulatkan ke bawah hingga ribuan penuh"
    }
   ],
   "recorded_on": "2009-01-01"
  },
  {
   "kind": "rule",
   "id": "REG.P16.PPH_ANNUAL",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "period",
   "produces": "pph_regular_annual",
   "condition": "not is_final_period",
   "expression": "round(progressive('pasal17', taxable_regular_annualized), 1, 'down')",
   "valid_from": "2009-01-01",
   "source": [
    {
     "document": "PER-16-PJ-2016",
     "provision": "Pasal 14 ayat (1)",
     "page": 13,
     "quote": "Tarif berdasarkan Pasal 17 ayat (1) huruf a"
    }
   ],
   "recorded_on": "2009-01-01"
  },
  {
   "kind": "rule",
   "id": "REG.P16.PPH_MONTH",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "period",
   "produces": "pph_regular_month",
   "condition": "not is_final_period",
   "expression": "round(pph_regular_annual / annualization_factor, 1, param('pph_round_mode'))",
   "valid_from": "2009-01-01",
   "source": [
    {
     "document": "PER-16-PJ-2016",
     "provision": "Pasal 14 ayat (3) huruf a",
     "page": 13,
     "quote": "atas penghasilan yang bersifat teratur adalah sebesar Pajak Penghasilan"
    }
   ],
   "recorded_on": "2009-01-01"
  },
  {
   "kind": "rule",
   "id": "REG.P16.TAXABLE_WITH_IRREGULAR",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "period",
   "produces": "taxable_with_irregular",
   "condition": "not is_final_period and irregular_gross > 0",
   "expression": "max(0, round((annualization_factor * regular_gross + irregular_gross) - min(round(param('job_expense_rate') * (annualization_factor * regular_gross + irregular_gross), 1, 'down'), param('job_expense_max_year')) - annualization_factor * employee_pension_contributions - ptkp_amount, 1000, 'down'))",
   "valid_from": "2009-01-01",
   "source": [
    {
     "document": "PER-16-PJ-2016",
     "provision": "Pasal 14 ayat (3) huruf b",
     "page": 13,
     "quote": "atas penghasilan yang bersifat tidak teratur adalah sebesar selisih antara Pajak"
    },
    {
     "document": "PER-16-PJ-2016",
     "provision": "Pasal 14 ayat (2) huruf b",
     "page": 13,
     "quote": "ditambah dengan jumlah"
    }
   ],
   "recorded_on": "2009-01-01"
  },
  {
   "kind": "rule",
   "id": "REG.P16.TAXABLE_WITHOUT_IRREGULAR",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "period",
   "produces": "taxable_without_irregular",
   "condition": "not is_final_period and irregular_gross > 0",
   "expression": "max(0, round(annualization_factor * regular_gross - min(round(param('job_expense_rate') * annualization_factor * regular_gross, 1, 'down'), param('job_expense_max_year')) - annualization_factor * employee_pension_contributions - ptkp_amount, 1000, 'down'))",
   "valid_from": "2009-01-01",
   "source": [
    {
     "document": "PER-16-PJ-2016",
     "provision": "Pasal 14 ayat (3) huruf b",
     "page": 13,
     "quote": "atas penghasilan yang bersifat tidak teratur adalah sebesar selisih antara Pajak"
    }
   ],
   "recorded_on": "2009-01-01"
  },
  {
   "kind": "rule",
   "id": "REG.P16.PPH_IRREGULAR",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "period",
   "produces": "pph_irregular_month",
   "condition": "not is_final_period and irregular_gross > 0",
   "expression": "round(progressive('pasal17', taxable_with_irregular), 1, 'down') - round(progressive('pasal17', taxable_without_irregular), 1, 'down')",
   "valid_from": "2009-01-01",
   "source": [
    {
     "document": "PER-16-PJ-2016",
     "provision": "Pasal 14 ayat (3) huruf b",
     "page": 13,
     "quote": "atas penghasilan yang bersifat tidak teratur adalah sebesar selisih antara Pajak"
    }
   ],
   "recorded_on": "2009-01-01"
  },
  {
   "kind": "rule",
   "id": "REG.P16.PPH_IRREGULAR.NONE",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "period",
   "produces": "pph_irregular_month",
   "condition": "not is_final_period and irregular_gross <= 0",
   "expression": "0",
   "valid_from": "2009-01-01",
   "source": [
    {
     "document": "PER-16-PJ-2016",
     "provision": "Pasal 14 ayat (3) huruf b",
     "page": 13,
     "quote": "atas penghasilan yang bersifat tidak teratur adalah sebesar selisih antara Pajak"
    }
   ],
   "recorded_on": "2009-01-01"
  },
  {
   "kind": "rule",
   "id": "REG.P16.RUNNING",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "period",
   "produces": "pph21_running",
   "condition": "not is_final_period",
   "expression": "pph_regular_month + pph_irregular_month",
   "valid_from": "2009-01-01",
   "source": [
    {
     "document": "PER-16-PJ-2016",
     "provision": "Pasal 14 ayat (3)",
     "page": 13,
     "quote": "dimaksud pada ayat (2) adalah:"
    }
   ],
   "recorded_on": "2009-01-01"
  },
  {
   "kind": "rule",
   "id": "REG.PPH.DUE.RUNNING",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "period",
   "produces": "pph21_due",
   "condition": "not is_final_period",
   "expression": "pph21_running",
   "valid_from": "2009-01-01",
   "source": [
    {
     "document": "PER-16-PJ-2016",
     "provision": "Pasal 14 ayat (2)",
     "page": 13,
     "quote": "harus dipotong setiap Masa Pajak, kecuali"
    }
   ],
   "recorded_on": "2009-01-01"
