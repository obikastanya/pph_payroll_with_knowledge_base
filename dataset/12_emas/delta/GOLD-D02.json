  {
   "kind": "rule",
   "id": "REG.JKN.WAGE.2014",
   "layer": "regulation",
   "modality": "mandatory",
   "scope": "period",
   "produces": "health_wage",
   "expression": "min(base_salary + fixed_allowance, round(2 * lookup('ptkp', 'K/1') / 12, 1, 'down'))",
   "valid_from": "2014-01-01",
   "label": "Pasal 16D: monthly cap 2 x PTKP K/1 / 12 of the PTKP table valid in the month",
   "source": [
    {
     "document": "PERPRES-111-2013",
     "provision": "Pasal 16D",
     "page": 13,
     "quote": "Batas paling tinggi Gaji atau Upah per bulan yang digunakan sebagai dasar perhitungan"
    },
    {
     "document": "PERPRES-111-2013",
     "provision": "Pasal 16D",
     "page": 13,
     "quote": "kali Penghasilan Tidak Kena Pajak (PTKP) dengan status kawin dengan 1 (satu) orang anak."
    },
    {
     "document": "PERPRES-111-2013",
     "provision": "Pasal 16E ayat (3)",
     "page": 14,
     "quote": "Jaminan Kesehatan sebagaimana dimaksud dalam Pasal 16C terdiri atas Gaji atau Upah pokok dan tunjangan tetap."
