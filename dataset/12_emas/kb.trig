        prov:wasRevisionOf <https://w3id.org/pph21kbs/kb/record/183> ;
        pph:elementId "REG.COVID_DTP.ELIGIBLE" ;
        pph:expression "(in_table('covid_dtp_klu', employer('klu')) or employer('kite') == True or employer('bonded_zone') == True) and covid_dtp_fixed_income * 12 <= param('covid_dtp_income_cap') and employee('tax_id_valid') != False" ;
