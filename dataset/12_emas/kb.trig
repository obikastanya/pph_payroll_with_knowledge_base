    <https://w3id.org/pph21kbs/kb/record/254> a pph:KBElement,
            pph:Rule ;
        prov:wasGeneratedBy <https://w3id.org/pph21kbs/kb/update/GOLD-E06> ;
        pph:condition "is_final_period" ;
        pph:elementId "REG.DTP.FINAL" ;
        pph:expression "((final_period_tax if final_period_tax >= 0 else final_period_tax + refund_to_employee) if dtp_facility else 0)" ;
        pph:hasSource <https://w3id.org/pph21kbs/kb/record/254/source/0>,
            <https://w3id.org/pph21kbs/kb/record/254/source/1>,
            <https://w3id.org/pph21kbs/kb/record/254/source/2>,
            <https://w3id.org/pph21kbs/kb/record/254/source/3> ;
        pph:layer pph:Regulation ;
        pph:modality pph:Mandatory ;
        pph:produces <https://w3id.org/pph21kbs/kb/fact/pph21_dtp> ;
        pph:reads <https://w3id.org/pph21kbs/kb/fact/dtp_facility>,
            <https://w3id.org/pph21kbs/kb/fact/final_period_tax>,
            <https://w3id.org/pph21kbs/kb/fact/refund_to_employee> ;
        pph:recordedOn "2025-02-04"^^xsd:date ;
        pph:scope pph:Period ;
        pph:seq 254 ;
        pph:validFrom "2025-01-01"^^xsd:date ;
        pph:validUntil "2025-12-31"^^xsd:date .

    <https://w3id.org/pph21kbs/kb/record/255> a pph:KBElement,
            pph:Rule ;
        rdfs:label "tafsir K13: over-withholding that came from DTP is not refunded"@en ;
        prov:wasGeneratedBy <https://w3id.org/pph21kbs/kb/update/GOLD-E06> ;
        pph:condition "dtp_eligible" ;
        pph:elementId "REG.DTP.REFUND" ;
        pph:expression "max(0, 0 - final_period_tax - sum_periods_before_final('pph21_dtp'))" ;
        pph:hasSource <https://w3id.org/pph21kbs/kb/record/255/source/0>,
            <https://w3id.org/pph21kbs/kb/record/255/source/1> ;
        pph:layer pph:Regulation ;
        pph:modality pph:Mandatory ;
        pph:overrides "REG.YEAR.REFUND" ;
        pph:overridesEntry <https://w3id.org/pph21kbs/kb/record/255/overrides/0> ;
        pph:produces <https://w3id.org/pph21kbs/kb/fact/refund_to_employee> ;
        pph:reads <https://w3id.org/pph21kbs/kb/fact/dtp_eligible>,
            <https://w3id.org/pph21kbs/kb/fact/final_period_tax>,
            <https://w3id.org/pph21kbs/kb/fact/pph21_dtp> ;
        pph:recordedOn "2025-02-04"^^xsd:date ;
        pph:scope pph:Year ;
        pph:seq 255 ;
        pph:validFrom "2025-01-01"^^xsd:date ;
        pph:validUntil "2025-12-31"^^xsd:date .

    <https://w3id.org/pph21kbs/kb/record/256> a pph:KBElement,
            pph:Rule ;
        rdfs:label "Pasal 5 ayat (1): the DTP is paid in cash also when the employer bears the tax, so it is cash the employee receives on top (negative tax burden)"@en ;
        prov:wasGeneratedBy <https://w3id.org/pph21kbs/kb/update/GOLD-E06> ;
        pph:condition "dtp_facility and withholding_method == 'employer_borne'" ;
        pph:elementId "REG.DTP.THP_CASH" ;
        pph:expression "0 - pph21_dtp" ;
        pph:hasSource <https://w3id.org/pph21kbs/kb/record/256/source/0>,
            <https://w3id.org/pph21kbs/kb/record/256/source/1>,
            <https://w3id.org/pph21kbs/kb/record/256/source/2> ;
        pph:layer pph:Regulation ;
        pph:modality pph:Mandatory ;
        pph:produces <https://w3id.org/pph21kbs/kb/fact/employee_tax_burden> ;
        pph:reads <https://w3id.org/pph21kbs/kb/fact/dtp_facility>,
            <https://w3id.org/pph21kbs/kb/fact/pph21_dtp>,
            <https://w3id.org/pph21kbs/kb/fact/withholding_method> ;
        pph:recordedOn "2025-02-04"^^xsd:date ;
        pph:scope pph:Period ;
        pph:seq 256 ;
        pph:validFrom "2025-01-01"^^xsd:date ;
        pph:validUntil "2025-12-31"^^xsd:date .

