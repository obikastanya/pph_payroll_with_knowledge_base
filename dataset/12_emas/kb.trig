    <https://w3id.org/pph21kbs/kb/record/170> a pph:KBElement,
            pph:Rule ;
        rdfs:label "tafsir K12: monthly benefits are regular income"@en ;
        prov:wasGeneratedBy <https://w3id.org/pph21kbs/kb/update/GOLD-E02> ;
        pph:elementId "REG.NATURA.REGULAR" ;
        pph:expression "max(0, benefit('housing_individual') - param('natura_housing_individual_cap')) + max(0, benefit('meal_coupon_field_duty') - param('natura_meal_coupon_cap')) + (benefit('company_vehicle') if (employee('has_equity_in_employer') == True or (employee('avg_monthly_gross_12m') if employee('avg_monthly_gross_12m') != None else base_salary + fixed_allowance) > param('natura_vehicle_gross_cap')) else 0) + benefit('other_benefit')" ;
        pph:hasSource <https://w3id.org/pph21kbs/kb/record/170/source/0>,
            <https://w3id.org/pph21kbs/kb/record/170/source/1>,
            <https://w3id.org/pph21kbs/kb/record/170/source/2>,
            <https://w3id.org/pph21kbs/kb/record/170/source/3>,
            <https://w3id.org/pph21kbs/kb/record/170/source/4>,
            <https://w3id.org/pph21kbs/kb/record/170/source/5>,
            <https://w3id.org/pph21kbs/kb/record/170/source/6>,
            <https://w3id.org/pph21kbs/kb/record/170/source/7>,
            <https://w3id.org/pph21kbs/kb/record/170/source/8> ;
        pph:layer pph:Regulation ;
        pph:modality pph:Mandatory ;
        pph:produces <https://w3id.org/pph21kbs/kb/fact/benefits_taxable_regular> ;
        pph:reads <https://w3id.org/pph21kbs/kb/fact/base_salary>,
            <https://w3id.org/pph21kbs/kb/fact/fixed_allowance> ;
        pph:recordedOn "2023-06-27"^^xsd:date ;
        pph:scope pph:Period ;
        pph:seq 170 ;
        pph:usesParameter "natura_housing_individual_cap",
            "natura_meal_coupon_cap",
            "natura_vehicle_gross_cap" ;
        pph:validFrom "2023-07-01"^^xsd:date .

    <https://w3id.org/pph21kbs/kb/record/171> a pph:KBElement,
            pph:Rule ;
        rdfs:label "tafsir K12: annual caps applied cumulatively; gifts are irregular income"@en ;
        prov:wasGeneratedBy <https://w3id.org/pph21kbs/kb/update/GOLD-E02> ;
        pph:elementId "REG.NATURA.IRREGULAR" ;
        pph:expression "max(0, cumulative('benefit_gift_other') - param('natura_gift_other_cap')) - max(0, cumulative_before('benefit_gift_other') - param('natura_gift_other_cap')) + max(0, cumulative('benefit_sports') - param('natura_sports_cap')) - max(0, cumulative_before('benefit_sports') - param('natura_sports_cap'))" ;
        pph:hasSource <https://w3id.org/pph21kbs/kb/record/171/source/0>,
            <https://w3id.org/pph21kbs/kb/record/171/source/1>,
            <https://w3id.org/pph21kbs/kb/record/171/source/2>,
