    <https://w3id.org/pph21kbs/kb/record/160> a pph:FactDefinition,
            pph:KBElement ;
        rdfs:label "minimum religious holiday allowance"@en,
            "THR keagamaan minimum"@id ;
        prov:wasGeneratedBy <https://w3id.org/pph21kbs/kb/update/BG-010> ;
        pph:definesFact <https://w3id.org/pph21kbs/kb/fact/thr_minimum> ;
