    <https://w3id.org/pph21kbs/kb/record/218> a pph:KBElement,
            pph:Rule ;
        rdfs:label "tafsir K12: monthly benefits are regular income"@en ;
        prov:wasGeneratedBy <https://w3id.org/pph21kbs/kb/update/GOLD-E02> ;
        pph:elementId "REG.NATURA.REGULAR" ;
        pph:expression "benefit_housing_taxable + max(0, benefit('meal_coupon_field_duty') - max(param('natura_meal_coupon_cap'), (employer('workplace_meal_value') if employer('workplace_meal_value') != None else 0))) + (benefit('company_vehicle') if (employee('has_equity_in_employer') == True or (employee('avg_monthly_gross_12m') if employee('avg_monthly_gross_12m') != None else base_salary + fixed_allowance) > param('natura_vehicle_gross_cap')) else 0) + benefit('other_benefit')" ;
        pph:hasSource <https://w3id.org/pph21kbs/kb/record/218/source/0>,
            <https://w3id.org/pph21kbs/kb/record/218/source/1>,
            <https://w3id.org/pph21kbs/kb/record/218/source/2>,
            <https://w3id.org/pph21kbs/kb/record/218/source/3>,
            <https://w3id.org/pph21kbs/kb/record/218/source/4>,
