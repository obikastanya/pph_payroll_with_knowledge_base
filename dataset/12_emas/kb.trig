    <https://w3id.org/pph21kbs/kb/record/198> a pph:KBElement,
            pph:Rule ;
        rdfs:label "from July 2021 only employers with a listed KLU (KITE and bonded zones no longer qualify)"@en ;
        prov:wasGeneratedBy <https://w3id.org/pph21kbs/kb/update/GOLD-D11> ;
        pph:elementId "REG.COVID_DTP.ELIGIBLE.2021H2" ;
        pph:expression "in_table('covid_dtp_klu', employer('klu')) and covid_dtp_fixed_income * 12 <= param('covid_dtp_income_cap') and employee('tax_id_valid') != False" ;
        pph:hasSource <https://w3id.org/pph21kbs/kb/record/198/source/0>,
            <https://w3id.org/pph21kbs/kb/record/198/source/1>,
            <https://w3id.org/pph21kbs/kb/record/198/source/2>,
            <https://w3id.org/pph21kbs/kb/record/198/source/3> ;
        pph:layer pph:Regulation ;
        pph:modality pph:Mandatory ;
        pph:produces <https://w3id.org/pph21kbs/kb/fact/covid_dtp_eligible> ;
        pph:reads <https://w3id.org/pph21kbs/kb/fact/covid_dtp_fixed_income> ;
        pph:recordedOn "2021-07-01"^^xsd:date ;
        pph:scope pph:Period ;
        pph:seq 198 ;
        pph:usesParameter "covid_dtp_income_cap" ;
        pph:usesTable "covid_dtp_klu" ;
        pph:validFrom "2021-07-01"^^xsd:date ;
        pph:validUntil "2021-12-31"^^xsd:date .

