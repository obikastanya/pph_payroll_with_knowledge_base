    <https://w3id.org/pph21kbs/kb/record/278> a pph:KBElement,
            pph:Rule ;
        rdfs:label "tafsir K18: under DTP the employer bears no tax, so a borne tax is no benefit to gross up; a tax allowance (gross_up method) stays income and the DTP is paid in cash on top"@en ;
