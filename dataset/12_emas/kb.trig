        pph:scope pph:Period ;
        pph:seq 194 ;
        pph:validFrom "2020-04-01"^^xsd:date ;
        pph:validUntil "2021-06-30"^^xsd:date .

    <https://w3id.org/pph21kbs/kb/record/195> a pph:KBElement,
            pph:Rule ;
        rdfs:label "over-withholding that came from DTP periods is not refunded (as tafsir K13)"@en ;
        prov:wasGeneratedBy <https://w3id.org/pph21kbs/kb/update/GOLD-D10> ;
        prov:wasRevisionOf <https://w3id.org/pph21kbs/kb/record/177> ;
        pph:elementId "REG.COVID_DTP.REFUND" ;
        pph:expression "max(0, 0 - final_period_tax - sum_periods_before_final('pph21_dtp'))" ;
        pph:hasSource <https://w3id.org/pph21kbs/kb/record/195/source/0>,
            <https://w3id.org/pph21kbs/kb/record/195/source/1>,
            <https://w3id.org/pph21kbs/kb/record/195/source/2>,
            <https://w3id.org/pph21kbs/kb/record/195/source/3> ;
        pph:layer pph:Regulation ;
        pph:modality pph:Mandatory ;
        pph:overrides "REG.YEAR.REFUND" ;
        pph:overridesEntry <https://w3id.org/pph21kbs/kb/record/195/overrides/0> ;
        pph:produces <https://w3id.org/pph21kbs/kb/fact/refund_to_employee> ;
        pph:reads <https://w3id.org/pph21kbs/kb/fact/final_period_tax>,
            <https://w3id.org/pph21kbs/kb/fact/pph21_dtp> ;
        pph:recordedOn "2021-02-02"^^xsd:date ;
        pph:scope pph:Year ;
        pph:seq 195 ;
        pph:validFrom "2020-04-01"^^xsd:date ;
        pph:validUntil "2021-06-30"^^xsd:date .

