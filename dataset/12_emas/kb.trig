            <https://w3id.org/pph21kbs/kb/record/160/source/3> ;
        pph:output false ;
        pph:recordedOn "2016-03-08"^^xsd:date ;
        pph:seq 160 .

    <https://w3id.org/pph21kbs/kb/record/161> a pph:KBElement,
            pph:Rule ;
        rdfs:label "THR minimum; employees whose employment ended within 30 days before the holiday keep the right"@en ;
        prov:wasGeneratedBy <https://w3id.org/pph21kbs/kb/update/BG-010> ;
        pph:elementId "REG.THR.MINIMUM" ;
        pph:expression "(round((base_salary + fixed_allowance) * min(hr('months_of_service'), 12) / 12, 1, 'down') if hr('months_of_service') >= 1 and hr('days_terminated_before_holiday') <= 30 else 0) if hr('thr_holiday') == 1 else 0" ;
        pph:hasSource <https://w3id.org/pph21kbs/kb/record/161/source/0>,
            <https://w3id.org/pph21kbs/kb/record/161/source/1>,
            <https://w3id.org/pph21kbs/kb/record/161/source/2>,
            <https://w3id.org/pph21kbs/kb/record/161/source/3>,
            <https://w3id.org/pph21kbs/kb/record/161/source/4>,
            <https://w3id.org/pph21kbs/kb/record/161/source/5> ;
        pph:layer pph:Regulation ;
        pph:modality pph:Mandatory ;
        pph:produces <https://w3id.org/pph21kbs/kb/fact/thr_minimum> ;
        pph:reads <https://w3id.org/pph21kbs/kb/fact/base_salary>,
            <https://w3id.org/pph21kbs/kb/fact/fixed_allowance> ;
        pph:recordedOn "2016-03-08"^^xsd:date ;
        pph:scope pph:Period ;
        pph:seq 161 ;
        pph:validFrom "2016-04-01"^^xsd:date .

    <https://w3id.org/pph21kbs/kb/record/162> a pph:Constraint,
            pph:KBElement ;
        rdfs:label "THR paid is not below the minimum"@en ;
        prov:wasGeneratedBy <https://w3id.org/pph21kbs/kb/update/BG-010> ;
        pph:assertion "thr >= thr_minimum" ;
        pph:condition "hr('thr_holiday') == 1" ;
        pph:conflictCode "C10" ;
        pph:elementId "CON.THR.MINIMUM" ;
        pph:hasSource <https://w3id.org/pph21kbs/kb/record/162/source/0>,
            <https://w3id.org/pph21kbs/kb/record/162/source/1>,
            <https://w3id.org/pph21kbs/kb/record/162/source/2> ;
        pph:reads <https://w3id.org/pph21kbs/kb/fact/thr>,
            <https://w3id.org/pph21kbs/kb/fact/thr_minimum> ;
        pph:recordedOn "2016-03-08"^^xsd:date ;
        pph:scope pph:Period ;
        pph:seq 162 ;
        pph:validFrom "2016-04-01"^^xsd:date .

