    <https://w3id.org/pph21kbs/kb/record/276> a pph:KBElement,
            pph:Rule ;
        prov:wasGeneratedBy <https://w3id.org/pph21kbs/kb/update/GOLD-E11> ;
        prov:wasRevisionOf <https://w3id.org/pph21kbs/kb/record/254> ;
        pph:condition "is_final_period" ;
        pph:elementId "REG.DTP.FINAL" ;
        pph:expression "((final_period_tax if final_period_tax >= 0 else final_period_tax + refund_to_employee) if dtp_facility else 0)" ;
        pph:hasSource <https://w3id.org/pph21kbs/kb/record/276/source/0>,
