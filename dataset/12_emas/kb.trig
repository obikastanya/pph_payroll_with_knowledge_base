    <https://w3id.org/pph21kbs/kb/record/90> a pph:KBElement,
            pph:Rule ;
        prov:wasGeneratedBy <https://w3id.org/pph21kbs/kb/update/BG-000> ;
        pph:elementId "REG.THP.CASH" ;
        pph:expression "base_salary + fixed_allowance + other_regular_income + overtime_pay + thr + bonus + other_irregular_income + (tax_allowance if withholding_method == 'gross_up' else 0)" ;
        pph:hasSource <https://w3id.org/pph21kbs/kb/record/90/source/0> ;
        pph:layer pph:Regulation ;
        pph:modality pph:Default ;
        pph:produces <https://w3id.org/pph21kbs/kb/fact/cash_income> ;
        pph:reads <https://w3id.org/pph21kbs/kb/fact/base_salary>,
            <https://w3id.org/pph21kbs/kb/fact/bonus>,
            <https://w3id.org/pph21kbs/kb/fact/fixed_allowance>,
            <https://w3id.org/pph21kbs/kb/fact/other_irregular_income>,
            <https://w3id.org/pph21kbs/kb/fact/other_regular_income>,
            <https://w3id.org/pph21kbs/kb/fact/overtime_pay>,
            <https://w3id.org/pph21kbs/kb/fact/tax_allowance>,
            <https://w3id.org/pph21kbs/kb/fact/thr>,
            <https://w3id.org/pph21kbs/kb/fact/withholding_method> ;
        pph:recordedOn "2009-01-01"^^xsd:date ;
        pph:scope pph:Period ;
        pph:seq 90 ;
        pph:validFrom "2009-01-01"^^xsd:date .

    <https://w3id.org/pph21kbs/kb/record/91> a pph:KBElement,
            pph:Rule ;
        prov:wasGeneratedBy <https://w3id.org/pph21kbs/kb/update/BG-000> ;
        pph:elementId "REG.THP.TAX_BURDEN" ;
        pph:expression "0 if withholding_method == 'employer_borne' else ((pph21_due - pph21_dtp) if (not is_final_period or pph21_due >= 0) else (0 - refund_to_employee))" ;
        pph:hasSource <https://w3id.org/pph21kbs/kb/record/91/source/0> ;
        pph:layer pph:Regulation ;
        pph:modality pph:Default ;
        pph:produces <https://w3id.org/pph21kbs/kb/fact/employee_tax_burden> ;
        pph:reads <https://w3id.org/pph21kbs/kb/fact/pph21_dtp>,
            <https://w3id.org/pph21kbs/kb/fact/pph21_due>,
            <https://w3id.org/pph21kbs/kb/fact/refund_to_employee>,
            <https://w3id.org/pph21kbs/kb/fact/withholding_method> ;
        pph:recordedOn "2009-01-01"^^xsd:date ;
        pph:scope pph:Period ;
        pph:seq 91 ;
        pph:validFrom "2009-01-01"^^xsd:date .

