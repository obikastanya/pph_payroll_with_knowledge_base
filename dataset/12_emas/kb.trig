    <https://w3id.org/pph21kbs/kb/record/219> a pph:KBElement,
            pph:Rule ;
        rdfs:label "Pasal 5 ayat (5) and (5a): only the part not borne by the government is refunded"@en ;
        prov:wasGeneratedBy <https://w3id.org/pph21kbs/kb/update/GOLD-E10> ;
        prov:wasRevisionOf <https://w3id.org/pph21kbs/kb/record/207> ;
        pph:condition "dtp_eligible or value_or('dtp_eligible_tourism', False)" ;
        pph:elementId "REG.DTP.REFUND" ;
        pph:expression "max(0, 0 - final_period_tax - sum_periods_before_final('pph21_dtp'))" ;
