{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Berkas aturan KB (research_plan.md §6.2)",
  "type": "object",
  "required": ["lapisan", "aturan"],
  "additionalProperties": false,
  "properties": {
    "lapisan": {"enum": ["regulasi", "perusahaan"]},
    "keterangan": {"type": "string"},
    "aturan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sifat", "berlaku", "lingkup", "menghasilkan", "maka", "tipe_hasil", "sumber"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9]+(-[A-Za-z0-9]+)+$"},
          "sifat": {"enum": ["wajib", "default", "opsional", "tafsir"]},
          "tafsir": {"type": "string"},
          "varian": {"type": "string"},
          "varian_default": {"type": "boolean"},
          "berlaku": {
            "type": "object", "required": ["mulai"], "additionalProperties": false,
            "properties": {"mulai": {"type": "string", "format": "date"}, "sampai": {"type": ["string", "null"]}}
          },
          "sumbu_waktu": {"enum": ["masa_pajak", "periode_iuran"]},
          "lingkup": {"enum": ["masa", "tahun"]},
          "menghasilkan": {"type": "string", "pattern": "^_?[a-z][a-z0-9_]*$"},
          "jika": {"type": "string"},
          "maka": {"type": "string"},
          "tipe_hasil": {"enum": ["rupiah", "tarif", "kategori", "bool", "bilangan", "eksak"]},
          "pembulatan": {"type": "string"},
          "titik_tetap": {"type": "boolean"},
          "prioritas": {"type": "integer"},
          "sumber": {"type": "string", "minLength": 1},
          "catatan": {"type": "string"}
        }
      }
    }
  }
}
