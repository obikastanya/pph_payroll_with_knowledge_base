   "layer": "regulation",
   "modality": "mandatory",
   "scope": "year",
   "produces": "dtp_income_test",
   "expression": "employee('contract_fixed_income') if employee('contract_fixed_income') != None else value_in('dtp_fixed_income', first_month)",
