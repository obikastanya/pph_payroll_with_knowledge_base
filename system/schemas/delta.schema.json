{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/pph21kbs/schemas/delta.schema.json",
  "title": "Knowledge base update (Delta)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "delta_id",
    "document",
    "relevant",
    "add",
    "change",
    "remove"
  ],
  "properties": {
    "delta_id": {
      "type": "string"
    },
    "event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "issued"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "issued": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "relevant": {
      "type": "boolean"
    },
    "add": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "change": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "remove": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/removal"
      }
    },
    "note": {
      "type": "string"
    },
    "adopts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?(/[0-9]+)?$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.\\-]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "provision",
        "quote"
      ],
      "properties": {
        "document": {
          "type": "string"
        },
        "provision": {
          "type": "string"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "removal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "recorded_on",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "recorded_on": {
          "$ref": "#/$defs/date"
        },
        "source": {
          "$ref": "#/$defs/sources"
        }
      }
    },
    "row": {
      "type": "object",
      "properties": {
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "lower": {
          "type": [
            "integer",
            "null"
          ]
        },
        "upper": {
          "type": [
            "integer",
            "null"
          ]
        },
        "value": {
          "type": [
            "string",
            "integer",
            "boolean",
            "null"
          ]
        },
        "rate": {
          "$ref": "#/$defs/decimal"
        }
      }
    },
    "element": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "recorded_on",
        "source"
      ],
      "properties": {
        "kind": {
          "enum": [
            "rule",
            "parameter",
            "table",
            "constraint",
            "fact"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "layer": {
          "enum": [
            "regulation",
            "company"
          ]
        },
        "modality": {
          "enum": [
            "mandatory",
            "default",
            "optional"
          ]
        },
        "scope": {
          "enum": [
            "period",
            "year"
          ]
        },
        "produces": {
          "type": "string"
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "expression": {
          "type": "string"
        },
        "assertion": {
          "type": "string"
        },
        "conflict_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^C([1-9]|10)$"
        },
        "fixed_point": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "lower",
            "upper"
          ],
          "properties": {
            "lower": {
              "type": "string"
            },
            "upper": {
              "type": "string"
            }
          }
        },
        "overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "adopts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "integer",
            "boolean"
          ]
        },
        "value_type": {
          "enum": [
            "money",
            "exact",
            "rate",
            "int",
            "bool",
            "category"
          ]
        },
        "table_kind": {
          "enum": [
            "lookup",
            "bracket",
            "progressive",
            "set"
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "rows_ref": {
          "type": "object",
          "required": [
            "extracted_table",
            "columns"
          ],
          "properties": {
            "extracted_table": {
              "type": "string"
            },
            "columns": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "value_scale": {
              "enum": [
                "unit",
                "percent"
              ]
            },
            "filter": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "fact_type": {
          "enum": [
            "money",
            "exact",
            "rate",
            "int",
            "bool",
            "category",
            "date"
          ]
        },
        "fact_scope": {
          "enum": [
            "period",
            "year"
          ]
        },
        "output": {
          "type": "boolean"
        },
        "unit": {
          "type": "string"
        },
        "valid_from": {
          "$ref": "#/$defs/date"
        },
        "valid_until": {
          "oneOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "recorded_on": {
          "$ref": "#/$defs/date"
        },
        "source": {
          "$ref": "#/$defs/sources"
        },
        "policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "label_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "rule"
              }
            }
          },
          "then": {
            "required": [
              "layer",
              "modality",
              "scope",
              "produces",
              "expression",
              "valid_from"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "parameter"
              }
            }
          },
          "then": {
            "required": [
              "name",
              "value",
              "value_type",
              "valid_from"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "table"
              }
            }
          },
          "then": {
            "required": [
              "name",
              "table_kind",
              "valid_from"
            ],
            "oneOf": [
              {
                "required": [
                  "rows"
                ]
              },
              {
                "required": [
                  "rows_ref"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "constraint"
              }
            }
          },
          "then": {
            "required": [
              "scope",
              "assertion",
              "conflict_code",
              "valid_from"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fact"
              }
            }
          },
          "then": {
            "required": [
              "fact_type",
              "fact_scope"
            ]
          }
        }
      ]
    }
  }
}