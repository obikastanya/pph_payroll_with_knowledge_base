{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/pph21kbs/schemas/expected.schema.json",
  "title": "Evaluation tuple with expected values",
  "type": "object",
  "required": ["tuple_id", "case_id", "omega", "kb", "periods", "year", "conflicts", "errors"],
  "properties": {
    "tuple_id": {"type": "string"},
    "case_id": {"type": "string"},
    "omega": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "kb": {"type": "string"},
    "periods": {"type": "object", "additionalProperties": {"type": "object"}},
    "year": {"type": "object"},
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
