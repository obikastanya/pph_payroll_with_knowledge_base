# Copy to .env in this folder and fill in what you need. Never commit .env.
# A variable set in the shell environment takes precedence over the same name in .env; for the Anthropic key,
# ANTHROPIC_API_KEY takes precedence over CLAUDE_API_KEY.
# The calculator, the knowledge-base viewer, and the tests need no key.

# Anthropic: drafts knowledge-base updates from new documents (ANTHROPIC_API_KEY is also accepted)
CLAUDE_API_KEY=

# OpenAI: the assistant of the app (optional)
OPENAI_API_KEY=

# Optional total spending limits per provider in USD, over all logged calls (empty = no limit)
# PPH21_BUDGET_ANTHROPIC_USD=10
# PPH21_BUDGET_OPENAI_USD=2

# Optional: where the app keeps its working state (default: ./workspace)
# PPH21_WORKSPACE=

# Optional: GraphDB endpoint for `python cli.py graphdb`
# PPH21_GRAPHDB_URL=http://localhost:7200
# PPH21_GRAPHDB_REPOSITORY=pph21
