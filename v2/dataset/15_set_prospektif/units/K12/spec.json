     },
     {
      "document": "K12",
      "provision": "Pasal 5 ayat (5)",
      "page": null,
      "quote": "Pekerja yang hubungan kerjanya berakhir sebelum hari raya keagamaan tidak berhak atas THR tahun yang bersangkutan."
