   {
    "kind": "rule",
    "id": "PRS.K12.THR",
    "layer": "company",
    "modality": "default",
    "scope": "period",
    "produces": "thr",
    "expression": "(round(sbh_wage * (dec('1.25') if hr('months_of_service') >= 60 else 1) * min(hr('months_of_service'), 12) / 12, 1, 'down') if hr('months_of_service') >= 1 and hr('days_terminated_before_holiday') == 0 else 0) if hr('thr_holiday') == 1 else income('thr')",
    "valid_from": "2027-01-01",
    "valid_until": "2028-12-31",
    "policy": "K12",
    "label": "THR of 1.25 months from 60 months of service, 1 month from 12, pro rata from 1 month",
    "source": [
     {
      "document": "K12",
      "provision": "Pasal 5 ayat (2)",
      "page": null,
      "quote": "menerima THR sebesar 1,25 (satu koma dua puluh lima) kali upah satu bulan"
     },
