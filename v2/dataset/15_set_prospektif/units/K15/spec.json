 "traps": [
  "nilai dalam huruf dan angka",
  "syarat implisit (penghasilan tetap menurut perjanjian kerja menentukan metode pajak)",
  "pengecualian (pekerja yang berhenti 30 hari atau kurang sebelum hari raya tetap berhak THR)",
  "pencabutan perjanjian dan memo lama"
 ],
 "title": "Perjanjian Kerja Bersama PT Mitra Niaga Sandang Periode 2027-2028",
 "header": "PT MITRA NIAGA SANDANG",
 "issued": "2026-12-16",
 "effective_from": "2027-01-01",
 "effective_until": "2028-12-31",
 "retroactive": false,
 "summary": "PKB 2027-2028: tunjangan PPh 21 (gross-up) hanya bagi penghasilan tetap bulanan Rp12.000.000 atau kurang, THR 1 bulan upah dengan pengecualian berhenti 30 hari atau kurang sebelum hari raya, komisi penjualan paling banyak Rp4.000.000, bonus akhir tahun hanya masa kerja 12 bulan atau lebih.",
 "gold": {
  "delta_id": "GOLD-K15",
  "event_id": "K15",
  "document": {
   "id": "K15",
   "title": "Perjanjian Kerja Bersama PT Mitra Niaga Sandang Periode 2027-2028",
   "issued": "2026-12-16"
  },
  "relevant": true,
  "add": [
   {
    "kind": "rule",
    "id": "PRS.K15.METHOD.GROSSUP",
    "layer": "company",
    "modality": "default",
    "scope": "year",
    "produces": "withholding_method",
    "condition": "(employee('contract_fixed_income') if employee('contract_fixed_income') != None else 0) <= 12000000",
    "expression": "'gross_up'",
    "valid_from": "2027-01-01",
    "valid_until": "2028-12-31",
    "policy": "K15",
    "label": "tax allowance by gross-up for contract fixed monthly income up to 12,000,000",
    "source": [
     {
      "document": "K15",
      "provision": "Pasal 2 ayat (1)",
      "page": null,
      "quote": "yang penghasilan tetap bulanannya menurut perjanjian kerja sebesar Rp12.000.000,00 (dua belas juta rupiah) atau kurang, dan tunjangan itu dihitung dengan metode gross-up"
     },
     {
      "document": "K15",
      "provision": "Pasal 7 ayat (1)",
      "page": null,
      "quote": "berlaku sejak tanggal 1 Januari 2027 sampai dengan tanggal 31 Desember 2028"
     }
    ],
    "recorded_on": "2026-12-16"
   },
   {
    "kind": "rule",
    "id": "PRS.K15.METHOD.GROSS",
    "layer": "company",
    "modality": "default",
    "scope": "year",
    "produces": "withholding_method",
    "condition": "(employee('contract_fixed_income') if employee('contract_fixed_income') != None else 0) > 12000000",
    "expression": "'gross'",
    "valid_from": "2027-01-01",
    "valid_until": "2028-12-31",
    "policy": "K15",
    "label": "tax withheld from the employee above 12,000,000",
    "source": [
     {
      "document": "K15",
      "provision": "Pasal 2 ayat (2)",
      "page": null,
      "quote": "lebih dari Rp12.000.000,00 (dua belas juta rupiah) dipotong dari penghasilan pekerja setiap bulan dan menjadi beban pekerja"
     },
     {
      "document": "K15",
      "provision": "Pasal 7 ayat (1)",
      "page": null,
      "quote": "berlaku sejak tanggal 1 Januari 2027 sampai dengan tanggal 31 Desember 2028"
     }
    ],
    "recorded_on": "2026-12-16"
   },
   {
    "kind": "rule",
    "id": "PRS.K15.THR",
    "layer": "company",
    "modality": "default",
    "scope": "period",
    "produces": "thr",
    "expression": "(round((income('base_salary') + income('fixed_allowance')) * min(hr('months_of_service'), 12) / 12, 1, 'down') if hr('months_of_service') >= 1 and hr('days_terminated_before_holiday') <= 30 else 0) if hr('thr_holiday') == 1 else income('thr')",
    "valid_from": "2027-01-01",
    "valid_until": "2028-12-31",
    "policy": "K15",
    "label": "THR of one month of wage, pro rata under 12 months, termination more than 30 days before the holiday loses it",
    "source": [
     {
      "document": "K15",
      "provision": "Pasal 3 ayat (1)",
      "page": null,
      "quote": "menerima Tunjangan Hari Raya Keagamaan (THR) sebesar 1 (satu) bulan upah"
     },
     {
      "document": "K15",
      "provision": "Pasal 3 ayat (2)",
      "page": null,
      "quote": "menerima THR sebesar masa kerja dalam bulan dibagi 12 (dua belas) dikali 1 (satu) bulan upah"
     },
     {
      "document": "K15",
      "provision": "Pasal 3 ayat (3)",
      "page": null,
      "quote": "berakhir 30 (tiga puluh) hari atau kurang sebelum hari raya keagamaan tetap berhak atas THR"
     },
     {
      "document": "K15",
      "provision": "Pasal 3 ayat (3)",
      "page": null,
      "quote": "berakhir lebih dari 30 (tiga puluh) hari sebelum hari raya keagamaan tidak berhak atas THR tahun yang bersangkutan"
     },
     {
      "document": "K15",
      "provision": "Pasal 7 ayat (1)",
      "page": null,
      "quote": "berlaku sejak tanggal 1 Januari 2027 sampai dengan tanggal 31 Desember 2028"
     }
    ],
    "recorded_on": "2026-12-16"
   },
   {
    "kind": "rule",
    "id": "PRS.K15.COMMISSION",
    "layer": "company",
    "modality": "default",
    "scope": "period",
    "produces": "other_regular_income",
    "expression": "income('other_regular') + min(hr('variable_sales_commission'), 4000000)",
    "valid_from": "2027-01-01",
    "valid_until": "2028-12-31",
    "policy": "K15",
    "label": "sales commission paid monthly as regular income up to 4,000,000",
    "source": [
     {
      "document": "K15",
      "provision": "Pasal 4",
      "page": null,
      "quote": "dibayarkan bersama upah bulan yang bersangkutan sebagai penghasilan teratur, paling banyak Rp4.000.000,00 (empat juta rupiah) sebulan"
     },
     {
      "document": "K15",
      "provision": "Pasal 7 ayat (1)",
      "page": null,
      "quote": "berlaku sejak tanggal 1 Januari 2027 sampai dengan tanggal 31 Desember 2028"
     }
    ],
    "recorded_on": "2026-12-16"
   },
   {
    "kind": "rule",
    "id": "PRS.K15.BONUS",
    "layer": "company",
    "modality": "default",
    "scope": "period",
    "produces": "bonus",
    "expression": "income('bonus') if hr('months_of_service') >= 12 else 0",
    "valid_from": "2027-01-01",
    "valid_until": "2028-12-31",
    "policy": "K15",
    "label": "year-end bonus only from 12 months of service",
    "source": [
     {
      "document": "K15",
      "provision": "Pasal 5",
      "page": null,
      "quote": "kepada pekerja dengan masa kerja 12 (dua belas) bulan atau lebih pada bulan pembayaran, dan pekerja dengan masa kerja kurang dari 12 (dua belas) bulan tidak menerima bonus akhir tahun"
     },
     {
      "document": "K15",
      "provision": "Pasal 7 ayat (1)",
      "page": null,
      "quote": "berlaku sejak tanggal 1 Januari 2027 sampai dengan tanggal 31 Desember 2028"
     }
    ],
    "recorded_on": "2026-12-16"
   }
  ],
