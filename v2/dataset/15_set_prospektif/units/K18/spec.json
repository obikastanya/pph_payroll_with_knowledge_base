   {
    "kind": "rule",
    "id": "PRS.K18.THR",
    "layer": "company",
    "modality": "default",
    "scope": "period",
    "produces": "thr",
    "condition": "hr('thr_holiday') > 0",
    "expression": "round((base_salary + fixed_allowance) * (min(hr('months_of_service'), 12) + 12 * k18_thr_extra_months) / 12, 1, 'down') if hr('months_of_service') >= 1 and hr('days_terminated_before_holiday') <= 30 else 0",
    "label": "THR on the wage plus the extra months by service, proportional below 12 months, none beyond 30 days after termination",
    "policy": "K18",
    "valid_from": "2027-01-01",
    "valid_until": "2028-12-31",
    "source": [
     {
      "document": "K18",
      "provision": "Pasal 7 ayat (2)",
      "page": null,
      "quote": "Pekerja dengan masa kerja 12 (dua belas) bulan atau lebih menerima THR sebesar 1 (satu) bulan Upah"
     },
