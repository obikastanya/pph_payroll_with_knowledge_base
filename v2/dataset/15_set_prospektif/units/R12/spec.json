  "change": [
   {
    "kind": "rule",
    "id": "REG.DTP.FIXED_INCOME",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "period",
    "produces": "dtp_fixed_income",
    "expression": "base_salary + fixed_allowance + other_regular_income + benefit('housing_individual') + benefit('company_vehicle')",
    "valid_from": "2025-01-01",
    "valid_until": "2027-12-31",
    "label": "tafsir K5: fixed and regular pay including fixed benefits in kind; without employer premiums, incidental overtime, THR, bonus",
    "source": [
     {
      "document": "R12",
      "provision": "Pasal 2 ayat (3)",
      "page": null,
      "quote": "meliputi gaji, tunjangan yang sifatnya tetap dan teratur, dan imbalan sejenis yang bersifat tetap dan teratur,"
     },
     {
      "document": "R12",
      "provision": "Pasal 2 ayat (3)",
      "page": null,
      "quote": "termasuk penerimaan dalam bentuk natura dan/atau kenikmatan."
     },
     {
      "document": "R12",
      "provision": "Pasal 1 ayat (1)",
      "page": null,
      "quote": "diperpanjang untuk Masa Pajak Januari 2027 sampai dengan Masa Pajak Desember 2027."
     }
    ],
    "recorded_on": "2027-02-18"
   },
   {
    "kind": "rule",
    "id": "REG.DTP.INCOME_TEST",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "year",
    "produces": "dtp_income_test",
    "expression": "employee('contract_fixed_income') if employee('contract_fixed_income') != None else value_in('dtp_fixed_income', first_month)",
    "valid_from": "2025-01-01",
    "valid_until": "2027-12-31",
    "label": "koreksi emas E0 (GT1 holdout PMK10-B-4): the criterion is the fixed regular income the contract gives for January or the first month (case attribute contract_fixed_income); without it, the fixed regular income paid in that month",
    "source": [
     {
      "document": "R12",
      "provision": "Pasal 2 ayat (1)",
      "page": null,
      "quote": "tidak lebih dari Rp10.000.000,00 (sepuluh juta rupiah) sebulan pada Masa Pajak Januari 2027"
     },
     {
      "document": "R12",
      "provision": "Pasal 2 ayat (1)",
      "page": null,
      "quote": "atau Masa Pajak bulan pertama bekerja bagi pegawai yang mulai bekerja setelah Januari 2027."
     },
     {
      "document": "R12",
      "provision": "Pasal 1 ayat (1)",
      "page": null,
      "quote": "diperpanjang untuk Masa Pajak Januari 2027 sampai dengan Masa Pajak Desember 2027."
     }
    ],
    "recorded_on": "2027-02-18"
   },
   {
    "kind": "rule",
    "id": "REG.DTP.ELIGIBLE",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "year",
    "produces": "dtp_eligible",
    "expression": "in_table('dtp_klu', employer('klu')) and dtp_income_test <= param('dtp_fixed_income_cap') and employee('tax_id_valid') != False and employee('other_dtp_incentive') != True",
    "valid_from": "2025-01-01",
    "valid_until": "2027-12-31",
    "source": [
     {
      "document": "R12",
      "provision": "Pasal 1 ayat (2)",
      "page": null,
      "quote": "memiliki kode klasifikasi lapangan usaha sebagaimana tercantum dalam Lampiran Peraturan Menteri Keuangan Nomor 105 Tahun 2025."
     },
     {
      "document": "R12",
      "provision": "Pasal 2 ayat (1)",
      "page": null,
      "quote": "tidak lebih dari Rp10.000.000,00 (sepuluh juta rupiah) sebulan pada Masa Pajak Januari 2027"
     },
     {
      "document": "R12",
      "provision": "Pasal 2 ayat (2)",
      "page": null,
      "quote": "tidak menerima insentif Pajak Penghasilan Pasal 21 ditanggung pemerintah lainnya."
     },
     {
      "document": "R12",
      "provision": "Pasal 1 ayat (1)",
      "page": null,
      "quote": "diperpanjang untuk Masa Pajak Januari 2027 sampai dengan Masa Pajak Desember 2027."
     }
    ],
    "recorded_on": "2027-02-18"
   },
   {
