   {
    "kind": "rule",
    "id": "REG.DTP.RUNNING",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "period",
    "produces": "pph21_dtp",
    "condition": "not is_final_period",
    "expression": "pph21_due if dtp_facility else 0",
    "valid_from": "2025-01-01",
    "valid_until": "2027-12-31",
    "source": [
     {
      "document": "R12",
      "provision": "Pasal 3 ayat (1)",
      "page": null,
      "quote": "dihitung dari Pajak Penghasilan Pasal 21 yang terutang pada Masa Pajak yang bersangkutan."
     },
     {
      "document": "R12",
      "provision": "Pasal 1 ayat (1)",
      "page": null,
      "quote": "diperpanjang untuk Masa Pajak Januari 2027 sampai dengan Masa Pajak Desember 2027."
     }
    ],
    "recorded_on": "2027-02-18"
   },
   {
    "kind": "rule",
    "id": "REG.DTP.FINAL",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "period",
    "produces": "pph21_dtp",
    "condition": "is_final_period",
    "expression": "((final_period_tax if final_period_tax >= 0 else final_period_tax + refund_to_employee) if dtp_facility else 0)",
    "valid_from": "2025-01-01",
    "valid_until": "2027-12-31",
    "source": [
     {
      "document": "R12",
      "provision": "Pasal 3 ayat (2)",
      "page": null,
      "quote": "dihitung dari Pajak Penghasilan Pasal 21 yang kurang dipotong pada Masa Pajak Terakhir."
     },
     {
      "document": "R12",
      "provision": "Pasal 3 ayat (3)",
      "page": null,
      "quote": "hanya dikembalikan kepada Pegawai Tertentu sebesar bagian yang tidak ditanggung pemerintah."
     },
     {
      "document": "R12",
      "provision": "Pasal 1 ayat (1)",
      "page": null,
      "quote": "diperpanjang untuk Masa Pajak Januari 2027 sampai dengan Masa Pajak Desember 2027."
     }
    ],
    "recorded_on": "2027-02-18"
   },
   {
    "kind": "rule",
    "id": "REG.DTP.REFUND",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "year",
    "produces": "refund_to_employee",
    "condition": "dtp_eligible or value_or('dtp_eligible_tourism', False)",
