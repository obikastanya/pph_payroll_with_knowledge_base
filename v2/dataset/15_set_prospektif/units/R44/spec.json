   },
   {
    "kind": "rule",
    "id": "REG.DTP.RUNNING",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "period",
    "produces": "pph21_dtp",
    "condition": "not is_final_period",
    "expression": "pph21_due if dtp_facility else 0",
    "valid_from": "2025-01-01",
    "valid_until": "2027-12-31",
    "source": [
     {
      "document": "R44",
      "provision": "Pasal 2 ayat (1)",
      "page": null,
      "quote": "diberikan insentif Pajak Penghasilan Pasal 21 ditanggung Pemerintah."
     },
     {
      "document": "R44",
      "provision": "Pasal 4 ayat (1)",
      "page": null,
      "quote": "tidak diperhitungkan sebagai penghasilan bagi Pegawai tertentu."
     },
     {
      "document": "R44",
      "provision": "Pasal 2 ayat (2)",
      "page": null,
      "quote": "diberikan untuk Masa Pajak Januari 2027 sampai dengan Masa Pajak Desember 2027."
     }
    ],
    "recorded_on": "2027-02-09"
   },
   {
    "kind": "rule",
    "id": "REG.DTP.FINAL",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "period",
    "produces": "pph21_dtp",
    "condition": "is_final_period",
    "expression": "((final_period_tax if final_period_tax >= 0 else final_period_tax + refund_to_employee) if dtp_facility else 0)",
    "valid_from": "2025-01-01",
    "valid_until": "2027-12-31",
    "source": [
     {
      "document": "R44",
      "provision": "Pasal 2 ayat (1)",
      "page": null,
      "quote": "diberikan insentif Pajak Penghasilan Pasal 21 ditanggung Pemerintah."
     },
     {
      "document": "R44",
      "provision": "Pasal 4 ayat (1)",
      "page": null,
      "quote": "tidak diperhitungkan sebagai penghasilan bagi Pegawai tertentu."
