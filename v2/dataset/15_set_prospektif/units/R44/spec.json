  "change": [
   {
    "kind": "rule",
    "id": "REG.DTP.FIXED_INCOME",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "period",
    "produces": "dtp_fixed_income",
    "expression": "base_salary + fixed_allowance + other_regular_income + benefit('housing_individual') + benefit('company_vehicle')",
    "valid_from": "2025-01-01",
    "label": "tafsir K5: fixed and regular pay including fixed benefits in kind; without employer premiums, incidental overtime, THR, bonus",
    "valid_until": "2027-12-31",
    "source": [
     {
      "document": "R44",
      "provision": "Pasal 3 ayat (2)",
      "page": null,
      "quote": "meliputi gaji pokok, tunjangan tetap, penghasilan teratur lainnya, serta nilai fasilitas tempat tinggal dan kendaraan dari Pemberi Kerja."
     },
     {
      "document": "R44",
      "provision": "Pasal 2 ayat (2)",
      "page": null,
      "quote": "diberikan untuk Masa Pajak Januari 2027 sampai dengan Masa Pajak Desember 2027."
     }
    ],
    "recorded_on": "2027-02-09"
   },
   {
    "kind": "rule",
    "id": "REG.DTP.INCOME_TEST",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "year",
    "produces": "dtp_income_test",
    "expression": "employee('contract_fixed_income') if employee('contract_fixed_income') != None else value_in('dtp_fixed_income', first_month)",
    "valid_from": "2025-01-01",
    "label": "koreksi emas E0 (GT1 holdout PMK10-B-4): the criterion is the fixed regular income the contract gives for January or the first month (case attribute contract_fixed_income); without it, the fixed regular income paid in that month",
    "valid_until": "2027-12-31",
    "source": [
     {
      "document": "R44",
      "provision": "Pasal 3 ayat (1) huruf c",
      "page": null,
      "quote": "tidak lebih dari Rp12.000.000,00 (dua belas juta rupiah) sebulan pada:"
     },
     {
      "document": "R44",
      "provision": "Pasal 3 ayat (1) huruf c angka 1",
      "page": null,
      "quote": "1. Masa Pajak Januari 2027, untuk Pegawai tertentu yang sudah bekerja"
     },
     {
      "document": "R44",
      "provision": "Pasal 3 ayat (1) huruf c angka 2",
      "page": null,
      "quote": "2. Masa Pajak bulan pertama bekerja, untuk Pegawai tertentu yang mulai bekerja setelah"
     },
     {
      "document": "R44",
      "provision": "Pasal 2 ayat (2)",
      "page": null,
      "quote": "diberikan untuk Masa Pajak Januari 2027 sampai dengan Masa Pajak Desember 2027."
     }
    ],
    "recorded_on": "2027-02-09"
   },
   {
    "kind": "rule",
    "id": "REG.DTP.ELIGIBLE",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "year",
    "produces": "dtp_eligible",
    "expression": "in_table('dtp_klu', employer('klu')) and dtp_income_test <= param('dtp_fixed_income_cap') and employee('tax_id_valid') != False and employee('other_dtp_incentive') != True",
    "valid_from": "2025-01-01",
    "valid_until": "2027-12-31",
    "source": [
     {
      "document": "R44",
      "provision": "Pasal 3 ayat (1) huruf b",
      "page": null,
      "quote": "melakukan kegiatan usaha pada bidang industri padat karya tertentu yang memiliki kode klasifikasi lapangan usaha"
     },
     {
      "document": "R44",
      "provision": "Pasal 3 ayat (1) huruf c",
