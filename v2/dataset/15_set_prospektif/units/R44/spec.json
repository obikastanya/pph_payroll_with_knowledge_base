     {
      "document": "R44",
      "provision": "Pasal 2 ayat (2)",
      "page": null,
      "quote": "diberikan untuk Masa Pajak Januari 2027 sampai dengan Masa Pajak Desember 2027."
     }
    ],
    "recorded_on": "2027-02-09"
   },
   {
    "kind": "rule",
    "id": "REG.DTP.REFUND",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "year",
    "produces": "refund_to_employee",
    "condition": "dtp_eligible or value_or('dtp_eligible_tourism', False)",
    "expression": "max(0, 0 - final_period_tax - sum_periods_before_final('pph21_dtp'))",
    "valid_from": "2025-01-01",
    "overrides": [
     "REG.YEAR.REFUND"
    ],
    "label": "Pasal 5 ayat (5) and (5a): only the part not borne by the government is refunded",
    "valid_until": "2027-12-31",
    "source": [
     {
      "document": "R44",
      "provision": "Pasal 5",
      "page": null,
      "quote": "kelebihan tersebut dikembalikan kepada Pegawai tertentu."
     },
     {
      "document": "R44",
      "provision": "Pasal 2 ayat (2)",
      "page": null,
      "quote": "diberikan untuk Masa Pajak Januari 2027 sampai dengan Masa Pajak Desember 2027."
     }
    ],
    "recorded_on": "2027-02-09"
   },
   {
    "kind": "rule",
    "id": "REG.DTP.NO_GROSSUP",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "period",
    "produces": "tax_allowance",
    "condition": "dtp_facility and withholding_method == 'employer_borne'",
    "expression": "0",
    "valid_from": "2025-01-01",
    "overrides": [
     "REG.BORNE.GROSSUP.RUNNING",
     "REG.BORNE.GROSSUP.FINAL"
    ],
    "label": "tafsir K18: under DTP the employer bears no tax, so a borne tax is no benefit to gross up; a tax allowance (gross_up method) stays income and the DTP is paid in cash on top",
    "valid_until": "2027-12-31",
    "source": [
     {
      "document": "R44",
      "provision": "Pasal 4 ayat (2)",
      "page": null,
      "quote": "Dalam hal Pemberi Kerja menanggung Pajak Penghasilan Pasal 21 Pegawai tertentu, Pajak Penghasilan Pasal 21 yang ditanggung Pemerintah tidak diberikan sebagai tunjangan pajak."
     },
     {
      "document": "R44",
      "provision": "Pasal 2 ayat (2)",
      "page": null,
      "quote": "diberikan untuk Masa Pajak Januari 2027 sampai dengan Masa Pajak Desember 2027."
     }
    ],
    "recorded_on": "2027-02-09"
   },
