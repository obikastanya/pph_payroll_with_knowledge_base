{
 "id": "R45",
 "layer": "regulation",
 "change_type": "T7",
 "size": 15,
 "traps": [
  "pasal yang menyatakan ulang ketentuan yang tidak berubah (Januari-Juni tetap TER, Masa Pajak Terakhir tetap)",
  "rujukan silang (tarif Pasal 17 UU PPh, batas biaya jabatan yang berlaku, PP 58/2023)",
  "ketentuan peralihan (mulai Juli 2027, bukan Januari)",
  "syarat implisit (pegawai baru dan bulan terakhir bekerja diketahui memakai faktor penyetahunan lain)",
  "pengecualian (Masa Pajak Terakhir tidak memakai metode ini)"
 ],
 "title": "PMK 757/2027: Perubahan PMK 168/2023: metode penyetahunan menggantikan TER untuk Masa Juli sampai November 2027",
 "header": "MENTERI KEUANGAN REPUBLIK INDONESIA",
 "issued": "2027-05-26",
 "effective_from": "2027-07-01",
 "effective_until": null,
 "retroactive": false,
 "summary": "Pemotongan PPh 21 pegawai tetap untuk Masa Pajak Juli sampai November 2027 memakai metode penyetahunan (biaya jabatan, PTKP, tarif Pasal 17, dibagi 12) dan bukan lagi tarif efektif bulanan; Januari-Juni dan Masa Pajak Terakhir tidak berubah.",
 "gold": {
  "add": [
   {
    "kind": "rule",
    "id": "REG.ANNUAL.JOB_EXPENSE_MONTH",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "period",
    "produces": "job_expense_month",
    "condition": "not is_final_period",
    "expression": "min(round(param('job_expense_rate') * regular_gross, 1, 'down'), param('job_expense_max_month'))",
    "valid_from": "2027-07-01",
    "source": [
     {
      "document": "R45",
      "provision": "Pasal 9A ayat (1)",
      "page": null,
      "quote": "Biaya jabatan dihitung sebesar 5% (lima persen) dari penghasilan bruto teratur sebulan, paling banyak sebesar batas tertinggi biaya jabatan sebulan yang berlaku."
     },
     {
      "document": "R45",
      "provision": "Pasal II",
      "page": null,
      "quote": "Peraturan Menteri ini mulai berlaku pada tanggal 1 Juli 2027."
     }
    ],
    "recorded_on": "2027-05-26"
   },
   {
    "kind": "rule",
    "id": "REG.ANNUAL.NET_MONTH",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "period",
    "produces": "net_regular_month",
    "condition": "not is_final_period",
    "expression": "regular_gross - job_expense_month - employee_pension_contributions",
    "valid_from": "2027-07-01",
    "source": [
     {
      "document": "R45",
      "provision": "Pasal 9A ayat (2)",
      "page": null,
      "quote": "Penghasilan neto teratur sebulan adalah penghasilan bruto teratur sebulan dikurangi biaya jabatan dan iuran pensiun yang dibayar oleh Pegawai."
     },
     {
      "document": "R45",
      "provision": "Pasal II",
      "page": null,
      "quote": "Peraturan Menteri ini mulai berlaku pada tanggal 1 Juli 2027."
     }
    ],
    "recorded_on": "2027-05-26"
   },
   {
    "kind": "rule",
    "id": "REG.ANNUAL.FACTOR",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "year",
    "produces": "annualization_factor",
    "expression": "12",
    "valid_from": "2027-07-01",
    "source": [
     {
      "document": "R45",
      "provision": "Pasal 9B ayat (1)",
      "page": null,
      "quote": "dengan mengalikannya dengan faktor penyetahunan sebesar 12 (dua belas)."
     },
     {
      "document": "R45",
      "provision": "Pasal II",
      "page": null,
      "quote": "Peraturan Menteri ini mulai berlaku pada tanggal 1 Juli 2027."
     }
    ],
    "recorded_on": "2027-05-26"
   },
   {
    "kind": "rule",
    "id": "REG.ANNUAL.FACTOR.NEW_EMPLOYEE",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "year",
    "produces": "annualization_factor",
    "condition": "first_month > 1 and employee('subjective_start_month') == None",
    "expression": "12 - first_month + 1",
    "valid_from": "2027-07-01",
    "overrides": [
     "REG.ANNUAL.FACTOR"
    ],
    "source": [
     {
      "document": "R45",
      "provision": "Pasal 9B ayat (2)",
      "page": null,
      "quote": "Bagi Pegawai yang mulai bekerja setelah bulan Januari, faktor penyetahunan adalah 12 (dua belas) dikurangi bulan pertama bekerja ditambah 1 (satu)."
     },
     {
      "document": "R45",
      "provision": "Pasal II",
      "page": null,
      "quote": "Peraturan Menteri ini mulai berlaku pada tanggal 1 Juli 2027."
     }
    ],
    "recorded_on": "2027-05-26"
   },
   {
    "kind": "rule",
    "id": "REG.ANNUAL.FACTOR.KNOWN_END",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "year",
    "produces": "annualization_factor",
    "condition": "employee('known_last_month') != None",
    "expression": "employee('known_last_month') - first_month + 1",
    "valid_from": "2027-07-01",
    "overrides": [
     "REG.ANNUAL.FACTOR",
     "REG.ANNUAL.FACTOR.NEW_EMPLOYEE"
    ],
    "source": [
     {
      "document": "R45",
      "provision": "Pasal 9B ayat (3)",
      "page": null,
      "quote": "faktor penyetahunan adalah bulan terakhir bekerja dikurangi bulan pertama bekerja ditambah 1 (satu)."
     },
     {
      "document": "R45",
      "provision": "Pasal II",
      "page": null,
      "quote": "Peraturan Menteri ini mulai berlaku pada tanggal 1 Juli 2027."
     }
    ],
    "recorded_on": "2027-05-26"
   },
   {
    "kind": "rule",
    "id": "REG.ANNUAL.TAXABLE_ANNUALIZED",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "period",
    "produces": "taxable_regular_annualized",
    "condition": "not is_final_period",
    "expression": "max(0, round(net_regular_month * annualization_factor - ptkp_amount, 1000, 'down'))",
    "valid_from": "2027-07-01",
    "source": [
     {
      "document": "R45",
      "provision": "Pasal 9C",
      "page": null,
      "quote": "Penghasilan Kena Pajak teratur yang disetahunkan adalah penghasilan neto teratur yang disetahunkan dikurangi Penghasilan Tidak Kena Pajak, dibulatkan ke bawah dalam ribuan rupiah penuh."
     },
     {
      "document": "R45",
      "provision": "Pasal 9B ayat (1)",
      "page": null,
      "quote": "dengan mengalikannya dengan faktor penyetahunan sebesar 12 (dua belas)."
     },
     {
      "document": "R45",
      "provision": "Pasal II",
      "page": null,
      "quote": "Peraturan Menteri ini mulai berlaku pada tanggal 1 Juli 2027."
     }
    ],
    "recorded_on": "2027-05-26"
   },
   {
    "kind": "rule",
    "id": "REG.ANNUAL.PPH_ANNUAL",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "period",
    "produces": "pph_regular_annual",
    "condition": "not is_final_period",
    "expression": "round(progressive('pasal17', taxable_regular_annualized), 1, 'down')",
    "valid_from": "2027-07-01",
    "source": [
     {
      "document": "R45",
      "provision": "Pasal 9D ayat (1)",
      "page": null,
      "quote": "dihitung dengan menerapkan tarif Pasal 17 ayat (1) huruf a Undang-Undang Pajak Penghasilan atas Penghasilan Kena Pajak teratur yang disetahunkan."
     },
     {
      "document": "R45",
      "provision": "Pasal II",
      "page": null,
      "quote": "Peraturan Menteri ini mulai berlaku pada tanggal 1 Juli 2027."
     }
    ],
    "recorded_on": "2027-05-26"
   },
   {
    "kind": "rule",
    "id": "REG.ANNUAL.PPH_MONTH",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "period",
    "produces": "pph_regular_month",
    "condition": "not is_final_period",
    "expression": "round(pph_regular_annual / annualization_factor, 1, param('pph_round_mode'))",
    "valid_from": "2027-07-01",
    "source": [
     {
      "document": "R45",
      "provision": "Pasal 9D ayat (2)",
      "page": null,
      "quote": "adalah Pajak Penghasilan Pasal 21 sebagaimana dimaksud pada ayat (1) dibagi dengan faktor penyetahunan."
     },
     {
      "document": "R45",
      "provision": "Pasal II",
      "page": null,
      "quote": "Peraturan Menteri ini mulai berlaku pada tanggal 1 Juli 2027."
     }
    ],
    "recorded_on": "2027-05-26"
   },
   {
    "kind": "rule",
    "id": "REG.ANNUAL.TAXABLE_WITH_IRREGULAR",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "period",
    "produces": "taxable_with_irregular",
    "condition": "not is_final_period and irregular_gross > 0",
    "expression": "max(0, round((annualization_factor * regular_gross + irregular_gross) - min(round(param('job_expense_rate') * (annualization_factor * regular_gross + irregular_gross), 1, 'down'), param('job_expense_max_year')) - annualization_factor * employee_pension_contributions - ptkp_amount, 1000, 'down'))",
    "valid_from": "2027-07-01",
    "source": [
     {
      "document": "R45",
      "provision": "Pasal 9E ayat (1)",
      "page": null,
      "quote": "dihitung dari seluruh penghasilan teratur yang disetahunkan ditambah penghasilan tidak teratur, dikurangi biaya jabatan setahun, iuran pensiun yang disetahunkan, dan Penghasilan Tidak Kena Pajak."
     },
     {
      "document": "R45",
      "provision": "Pasal II",
      "page": null,
      "quote": "Peraturan Menteri ini mulai berlaku pada tanggal 1 Juli 2027."
     }
    ],
    "recorded_on": "2027-05-26"
   },
   {
    "kind": "rule",
    "id": "REG.ANNUAL.TAXABLE_WITHOUT_IRREGULAR",
    "layer": "regulation",
    "modality": "mandatory",
    "scope": "period",
    "produces": "taxable_without_irregular",
    "condition": "not is_final_period and irregular_gross > 0",
    "expression": "max(0, round(annualization_factor * regular_gross - min(round(param('job_expense_rate') * annualization_factor * regular_gross, 1, 'down'), param('job_expense_max_year')) - annualization_factor * employee_pension_contributions - ptkp_amount, 1000, 'down'))",
    "valid_from": "2027-07-01",
    "source": [
     {
      "document": "R45",
      "provision": "Pasal 9E ayat (2)",
      "page": null,
      "quote": "Penghasilan Kena Pajak tanpa penghasilan tidak teratur dihitung dari penghasilan teratur yang disetahunkan"
     },
     {
      "document": "R45",
      "provision": "Pasal 9E ayat (1)",
      "page": null,
      "quote": "dihitung dari seluruh penghasilan teratur yang disetahunkan ditambah penghasilan tidak teratur, dikurangi biaya jabatan setahun, iuran pensiun yang disetahunkan, dan Penghasilan Tidak Kena Pajak."
     },
     {
      "document": "R45",
      "provision": "Pasal II",
      "page": null,
      "quote": "Peraturan Menteri ini mulai berlaku pada tanggal 1 Juli 2027."
     }
    ],
    "recorded_on": "2027-05-26"
   },
   {
    "kind": "rule",
    "id": "REG.ANNUAL.PPH_IRREGULAR",
