APP_NAME="Payroll PPh 21"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100
SERVER_PORT=8100

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Bawaan SQLite (database/database.sqlite). Untuk PostgreSQL: ganti DB_CONNECTION=pgsql dan isi baris di bawahnya
# (butuh ekstensi PHP pdo_pgsql; database harus sudah dibuat). Apit password dengan tanda kutip bila berisi simbol.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=its_pph21
# DB_USERNAME=postgres
# DB_PASSWORD=""

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Detik sebelum job yang belum selesai dianggap hilang dan diambil ulang. Wajib lebih besar dari PAYROLL_LLM_TIMEOUT + 60
# (batas waktu job asisten KB); bila lebih kecil, pekerja kedua mengambil ulang job yang masih berjalan dan menandainya gagal.
DB_QUEUE_RETRY_AFTER=1080

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Engine KB (Python) di repositori induk; kosong = otomatis (folder induk web/ dan venv env/) ---
PAYROLL_ROOT=
PAYROLL_PYTHON=
PAYROLL_TIMEOUT=300
# KLU pemberi kerja untuk fasilitas PPh 21 DTP 2025-2026 (kosong = tidak diketahui)
PAYROLL_KLU=

# --- Asisten KB (menu Basis pengetahuan): PDF peraturan -> rancangan berkas KB lewat LLM ---
# Butuh antrean berjalan: php artisan queue:work --timeout=960
# Penyedia mengikuti nama model: gpt-... memakai OPENAI_API_KEY; claude-... memakai ANTHROPIC_API_KEY.
PAYROLL_LLM_MODEL=gpt-5.6-sol
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PAYROLL_LLM_TIMEOUT=900
